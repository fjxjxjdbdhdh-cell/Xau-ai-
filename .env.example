"""
aurum_v3_final.py
XAU/USD | AURUM V3.0 | Без стоп-лосса | TP min $10
Python 3.11.9 | VS Code | Полностью рабочий
"""

import json
import time
import random
import logging
import threading
import sqlite3
from datetime import datetime, timedelta
from typing import Optional, Dict, Any, List, Tuple, Callable
from dataclasses import dataclass, field
from enum import Enum
from collections import deque
import numpy as np

# ============================================================
# КОНСТАНТЫ
# ============================================================

SYMBOL = "XAUUSD"
FIXED_LOT = 0.02
MIN_PROFIT_DOLLARS = 10.0  # Минимальная прибыль $10
MAGIC_NUMBER = 777
INITIAL_BALANCE = 100

NEWS_EVENTS = [
    (2026, 7, 10, 12, 30, "NFP"),
    (2026, 8, 7, 12, 30, "NFP"),
    (2026, 9, 4, 12, 30, "NFP"),
    (2026, 7, 29, 18, 0, "FOMC"),
    (2026, 9, 17, 18, 0, "FOMC"),
    (2026, 7, 14, 12, 30, "CPI"),
    (2026, 8, 12, 12, 30, "CPI"),
    (2026, 9, 15, 12, 30, "CPI"),
]

LONDON_START = 7
LONDON_END = 16
NY_START = 12
NY_END = 21

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s',
    handlers=[
        logging.StreamHandler(),
        logging.FileHandler('aurum_v3.log', encoding='utf-8')
    ]
)
logger = logging.getLogger("AURUM_V3")

# ============================================================
# ЕНАМЫ И МОДЕЛИ
# ============================================================

class StrategyMode(Enum):
    AURUM_V3 = "aurum_v3"
    MANUAL = "manual"

class Direction(Enum):
    BUY = 1
    SELL = -1
    NONE = 0

@dataclass
class Candle:
    time: datetime
    open: float
    high: float
    low: float
    close: float
    tick_volume: float
    spread: float = 0.0

@dataclass
class TradeSignal:
    direction: Direction
    entry_price: float
    stop_loss: float
    take_profit: float
    pattern: str
    confidence: float
    r_ratio: float
    timestamp: float = field(default_factory=time.time)
    tp1: float = 0.0

@dataclass
class Position:
    ticket: int
    direction: Direction
    entry_price: float
    stop_loss: float
    take_profit: float
    volume: float
    open_time: datetime
    pattern: str
    is_breakeven: bool = False
    tp1: float = 0.0
    tp1_hit: bool = False
    highest_price: float = 0.0
    lowest_price: float = float('inf')

# ============================================================
# НОВОСТНОЙ ФИЛЬТР
# ============================================================

class NewsFilter:
    def __init__(self, events=None):
        self.events = events or NEWS_EVENTS

    def is_news_near(self):
        now = datetime.utcnow()
        for event in self.events:
            try:
                event_time = datetime(event[0], event[1], event[2], event[3], event[4])
                if abs((now - event_time).total_seconds()) < 900:
                    return True
            except (ValueError, IndexError):
                continue
        return False

# ============================================================
# MT5 ИНТЕГРАЦИЯ
# ============================================================

class MT5Integration:
    _instances: Dict[str, 'MT5Integration'] = {}
    _lock = threading.Lock()

    def __new__(cls, connection_id: str = "default", **kwargs):
        with cls._lock:
            if connection_id not in cls._instances:
                instance = super().__new__(cls)
                instance._initialized = False
                cls._instances[connection_id] = instance
            return cls._instances[connection_id]

    def __init__(self, connection_id: str = "default", path=None, login=None, password=None, server=None):
        if getattr(self, '_initialized', False):
            return
        self.connection_id = connection_id
        self.path = path
        self.login = login
        self.password = password
        self.server = server
        self.connected = False
        self._mt5 = None
        try:
            import MetaTrader5 as mt5
            self._mt5 = mt5
            logger.info("MetaTrader5 импортирован успешно")
        except ImportError:
            logger.warning("MetaTrader5 не установлен. Демо-режим.")
        self._initialized = True

    def connect(self) -> bool:
        if self._mt5 is None:
            self.connected = True
            logger.info("Демо-режим: MT5 не требуется")
            return True
        try:
            if not self._mt5.initialize():
                error = self._mt5.last_error()
                logger.error(f"Ошибка MT5: {error}")
                return False
            self.connected = True
            logger.info("MT5 подключён успешно")
            return True
        except Exception as e:
            logger.error(f"Исключение MT5: {e}")
            return False

    def disconnect(self):
        if self._mt5 and self.connected:
            self._mt5.shutdown()
            self.connected = False
            logger.info("MT5 отключён")

    def reconnect(self) -> bool:
        self.disconnect()
        time.sleep(2)
        return self.connect()

    def get_account_info(self) -> Dict:
        if not self.connected or self._mt5 is None:
            return {"balance": INITIAL_BALANCE, "equity": INITIAL_BALANCE, "margin": 0, "free_margin": INITIAL_BALANCE}
        try:
            info = self._mt5.account_info()
            if info is None:
                return {"balance": INITIAL_BALANCE, "equity": INITIAL_BALANCE, "margin": 0, "free_margin": INITIAL_BALANCE}
            return {
                "balance": info.balance, "equity": info.equity,
                "margin": info.margin, "free_margin": info.margin_free
            }
        except Exception:
            return {"balance": INITIAL_BALANCE, "equity": INITIAL_BALANCE, "margin": 0, "free_margin": INITIAL_BALANCE}

    def get_positions(self, symbol=None) -> List[Dict]:
        if not self.connected or self._mt5 is None:
            return []
        try:
            positions = self._mt5.positions_get(symbol=symbol) if symbol else self._mt5.positions_get()
            if positions is None:
                return []
            result = []
            for pos in positions:
                result.append({
                    "ticket": pos.ticket, "symbol": pos.symbol,
                    "type": "BUY" if pos.type == 0 else "SELL",
                    "volume": pos.volume, "open_price": pos.price_open,
                    "current_price": pos.price_current,
                    "sl": pos.sl, "tp": pos.tp, "profit": pos.profit,
                    "open_time": datetime.fromtimestamp(pos.time)
                })
            return result
        except Exception:
            return []

    def open_order(self, symbol: str, order_type: str, volume: float,
                   price=0.0, sl=0.0, tp=0.0, comment="AURUM") -> Optional[int]:
        """Открыть ордер. Если sl=0 или tp=0 — ордер без стопа/тейка."""
        if not self.connected or self._mt5 is None:
            ticket = random.randint(10000, 99999)
            sl_str = f"SL={sl:.2f}" if sl > 0 else "БЕЗ SL"
            tp_str = f"TP={tp:.2f}" if tp > 0 else "БЕЗ TP"
            logger.info(f"[DEMO] {order_type} {symbol} {volume}лот @ {price:.2f} {sl_str} {tp_str} ticket={ticket}")
            return ticket
        try:
            request = {
                "action": self._mt5.TRADE_ACTION_DEAL,
                "symbol": symbol,
                "volume": volume,
                "type": self._mt5.ORDER_TYPE_BUY if order_type.upper() == "BUY" else self._mt5.ORDER_TYPE_SELL,
                "price": price if price > 0 else self._get_real_price(symbol, order_type),
                "sl": sl,
                "tp": tp,
                "deviation": 20,
                "magic": MAGIC_NUMBER,
                "comment": comment,
                "type_time": self._mt5.ORDER_TIME_GTC,
                "type_filling": self._mt5.ORDER_FILLING_IOC,
            }
            result = self._mt5.order_send(request)
            if result is None:
                logger.error("order_send вернул None")
                return None
            if result.retcode != self._mt5.TRADE_RETCODE_DONE:
                logger.error(f"Ошибка ордера: retcode={result.retcode} comment={result.comment}")
                return None
            logger.info(f"Ордер открыт: ticket={result.order}")
            return result.order
        except Exception as e:
            logger.error(f"Исключение при открытии ордера: {e}")
            return None

    def close_position(self, ticket: int, volume=None) -> bool:
        if not self.connected or self._mt5 is None:
            logger.info(f"[DEMO] Позиция {ticket} закрыта (volume={volume})")
            return True
        try:
            pos = self._mt5.positions_get(ticket=ticket)
            if pos is None or len(pos) == 0:
                logger.warning(f"Позиция {ticket} не найдена для закрытия")
                return False
            pos = pos[0]
            close_type = self._mt5.ORDER_TYPE_SELL if pos.type == 0 else self._mt5.ORDER_TYPE_BUY
            tick = self._mt5.symbol_info_tick(pos.symbol)
            if tick is None:
                logger.error("Не удалось получить тик для закрытия")
                return False
            close_price = tick.bid if close_type == self._mt5.ORDER_TYPE_SELL else tick.ask
            request = {
                "action": self._mt5.TRADE_ACTION_DEAL,
                "symbol": pos.symbol,
                "volume": volume if volume else pos.volume,
                "type": close_type,
                "position": ticket,
                "price": close_price,
                "deviation": 20,
                "magic": MAGIC_NUMBER,
                "comment": "Close AURUM",
                "type_time": self._mt5.ORDER_TIME_GTC,
                "type_filling": self._mt5.ORDER_FILLING_IOC,
            }
            result = self._mt5.order_send(request)
            if result is None:
                logger.error("order_send при закрытии вернул None")
                return False
            if result.retcode != self._mt5.TRADE_RETCODE_DONE:
                logger.error(f"Ошибка закрытия: retcode={result.retcode} comment={result.comment}")
                return False
            logger.info(f"Позиция {ticket} закрыта")
            return True
        except Exception as e:
            logger.error(f"Исключение при закрытии: {e}")
            return False

    def modify_position(self, ticket: int, sl=None, tp=None) -> bool:
        if not self.connected or self._mt5 is None:
            logger.info(f"[DEMO] Позиция {ticket} изменена: SL={sl} TP={tp}")
            return True
        try:
            pos = self._mt5.positions_get(ticket=ticket)
            if pos is None or len(pos) == 0:
                logger.warning(f"Позиция {ticket} не найдена для модификации")
                return False
            pos = pos[0]
            request = {
                "action": self._mt5.TRADE_ACTION_SLTP,
                "position": ticket,
                "symbol": pos.symbol,
                "sl": sl if sl is not None else pos.sl,
                "tp": tp if tp is not None else pos.tp,
            }
            result = self._mt5.order_send(request)
            if result is None:
                return False
            if result.retcode != self._mt5.TRADE_RETCODE_DONE:
                logger.error(f"Ошибка модификации: retcode={result.retcode}")
                return False
            logger.info(f"Позиция {ticket} изменена")
            return True
        except Exception as e:
            logger.error(f"Исключение при модификации: {e}")
            return False

    def get_rates(self, symbol: str, timeframe, count: int = 100) -> List[Candle]:
        if not self.connected or self._mt5 is None:
            return self._generate_demo_rates(count)
        try:
            rates = self._mt5.copy_rates_from_pos(symbol, timeframe, 0, count)
            if rates is None or len(rates) == 0:
                logger.warning(f"Нет данных для {symbol} timeframe={timeframe}")
                return self._generate_demo_rates(count)
            candles = []
            for r in rates:
                candles.append(Candle(
                    time=datetime.fromtimestamp(r['time']),
                    open=float(r['open']), high=float(r['high']),
                    low=float(r['low']), close=float(r['close']),
                    tick_volume=float(r.get('tick_volume', r.get('real_volume', 100))),
                    spread=float(r.get('spread', 0))
                ))
            return candles
        except Exception as e:
            logger.error(f"Ошибка получения свечей: {e}")
            return self._generate_demo_rates(count)

    def _get_real_price(self, symbol: str, order_type: str) -> float:
        if not self.connected or self._mt5 is None:
            return 4108.0
        try:
            tick = self._mt5.symbol_info_tick(symbol)
            if tick is None:
                return 4108.0
            return tick.ask if order_type.upper() == "BUY" else tick.bid
        except Exception:
            return 4108.0

    def _generate_demo_rates(self, count: int) -> List[Candle]:
        candles = []
        price = 4108.0
        now = datetime.utcnow()
        for i in range(count):
            change = random.uniform(-3, 3)
            price += change
            candle_time = now - timedelta(hours=count - i)
            candles.append(Candle(
                time=candle_time,
                open=price - random.uniform(-1, 1),
                high=price + random.uniform(0.5, 2),
                low=price - random.uniform(0.5, 2),
                close=price,
                tick_volume=random.uniform(100, 1000)
            ))
        return candles

# ============================================================
# MARKET INTELLIGENCE
# ============================================================

class MarketIntelligence:
    def __init__(self):
        self.h4_candles = []
        self.h1_candles = []
        self.m15_candles = []
        self.swing_highs = []
        self.swing_lows = []
        self.support_levels = []
        self.resistance_levels = []
        self.volatility = 0.0
        self.trend_strength = 0.0
        self.momentum = 0.0
        self.regime = "neutral"
        self.volume_profile = {}
        self.order_blocks = []
        self.fvg_zones = []
        self.imbalance_zones = []
        self.liquidity_zones = []

    def update(self, h4, h1, m15):
        self.h4_candles = h4 or []
        self.h1_candles = h1 or []
        self.m15_candles = m15 or []
        if not self.h4_candles:
            return
        self._update_swing_points()
        self._calc_volatility()
        self._calc_trend_strength()
        self._calc_momentum()
        self._detect_regime()
        self._find_real_support_levels()
        self._find_real_resistance_levels()
        self._calc_volume_profile()
        self._find_order_blocks()
        self._find_fvg_zones()
        self._find_liquidity_zones()
        self._find_imbalance_zones()

    def get_regime(self):
        return self.regime

    def get_support_levels(self):
        return self.support_levels

    def get_resistance_levels(self):
        return self.resistance_levels

    def _update_swing_points(self):
        if len(self.h4_candles) < 5:
            return
        for i in range(2, len(self.h4_candles) - 2):
            c = self.h4_candles[i]
            left_high = all(c.high > self.h4_candles[i - j].high for j in range(1, 3))
            right_high = all(c.high > self.h4_candles[i + j].high for j in range(1, 3))
            if left_high and right_high:
                self.swing_highs.append(c.high)
            left_low = all(c.low < self.h4_candles[i - j].low for j in range(1, 3))
            right_low = all(c.low < self.h4_candles[i + j].low for j in range(1, 3))
            if left_low and right_low:
                self.swing_lows.append(c.low)

    def _calc_volatility(self):
        if len(self.h1_candles) < 14:
            return
        ranges = [c.high - c.low for c in self.h1_candles[-14:]]
        self.volatility = sum(ranges) / len(ranges)

    def _calc_trend_strength(self):
        if len(self.h4_candles) < 20:
            return
        closes = [c.close for c in self.h4_candles[-20:]]
        x = list(range(20))
        try:
            slope = np.polyfit(x, closes, 1)[0]
            self.trend_strength = (slope / closes[-1]) * 100 if closes[-1] != 0 else 0.0
        except (np.linalg.LinAlgError, ValueError):
            self.trend_strength = 0.0

    def _calc_momentum(self):
        if len(self.h4_candles) < 10:
            return
        self.momentum = self.h4_candles[-1].close - self.h4_candles[-10].close

    def _detect_regime(self):
        if abs(self.trend_strength) > 0.02:
            self.regime = "trending_up" if self.trend_strength > 0 else "trending_down"
        elif self.volatility > 5:
            self.regime = "volatile"
        else:
            self.regime = "ranging"

    def _find_real_support_levels(self):
        if self.swing_lows:
            self.support_levels = sorted(set(round(s, 1) for s in self.swing_lows[-5:]))

    def _find_real_resistance_levels(self):
        if self.swing_highs:
            self.resistance_levels = sorted(set(round(s, 1) for s in self.swing_highs[-5:]))

    def _calc_volume_profile(self):
        if not self.h1_candles:
            return
        for c in self.h1_candles[-50:]:
            level = round(c.close, 0)
            self.volume_profile[level] = self.volume_profile.get(level, 0) + c.tick_volume

    def get_volume_peaks(self, top_n=3):
        if not self.volume_profile:
            return []
        sorted_levels = sorted(self.volume_profile.items(), key=lambda x: x[1], reverse=True)
        return [level for level, _ in sorted_levels[:top_n]]

    def get_level_strength(self, level, tolerance=0.5):
        touches = sum(1 for c in self.h1_candles[-100:]
                      if abs(c.high - level) < tolerance or abs(c.low - level) < tolerance)
        vol = sum(c.tick_volume for c in self.h1_candles[-100:]
                  if abs(c.close - level) < tolerance)
        all_levels = self.support_levels + self.resistance_levels
        if not all_levels:
            return 0.5
        max_touches = max(1, max(sum(1 for c in self.h1_candles[-100:]
                                     if abs(c.high - l) < tolerance or abs(c.low - l) < tolerance)
                                 for l in all_levels))
        max_vol = max(1, max(sum(c.tick_volume for c in self.h1_candles[-100:]
                                 if abs(c.close - l) < tolerance)
                             for l in all_levels))
        return min(1.0, (touches / max_touches * 0.5 + vol / max_vol * 0.5))

    def detect_market_structure(self):
        if len(self.swing_highs) < 2 or len(self.swing_lows) < 2:
            return "neutral"
        hh = self.swing_highs[-1] > self.swing_highs[-2]
        hl = self.swing_lows[-1] > self.swing_lows[-2]
        lh = self.swing_highs[-1] < self.swing_highs[-2]
        ll = self.swing_lows[-1] < self.swing_lows[-2]
        if hh and hl:
            return "bullish"
        if lh and ll:
            return "bearish"
        return "neutral"

    def get_liquidity_zones(self):
        zones = []
        if len(self.swing_lows) >= 3:
            zones.append({"side": "below", "price": min(self.swing_lows[-3:]) - 1.0})
        if len(self.swing_highs) >= 3:
            zones.append({"side": "above", "price": max(self.swing_highs[-3:]) + 1.0})
        return zones

    def get_imbalance_zones(self):
        zones = []
        for i in range(1, min(len(self.h1_candles), 20)):
            c = self.h1_candles[-i]
            body = abs(c.close - c.open)
            candle_range = c.high - c.low
            if candle_range > 0 and body > candle_range * 0.7 and body > self.volatility * 1.5:
                zones.append({"low": min(c.open, c.close), "high": max(c.open, c.close)})
        return zones

    def get_order_blocks(self):
        blocks = []
        for i in range(2, min(len(self.h1_candles), 30)):
            prev = self.h1_candles[-i]
            curr = self.h1_candles[-i + 1]
            candle_range = curr.high - curr.low
            if candle_range > 0:
                body_ratio = abs(curr.close - curr.open) / candle_range
                if body_ratio > 0.6 and abs(curr.close - curr.open) > self.volatility:
                    blocks.append({"low": min(prev.low, prev.open), "high": max(prev.high, prev.close)})
        return blocks[-3:] if blocks else []

    def detect_choch(self):
        return self.detect_market_structure() == "neutral"

    def detect_bos(self):
        if not self.swing_highs or not self.swing_lows:
            return False
        if not self.h4_candles:
            return False
        price = self.h4_candles[-1].close
        return price > self.swing_highs[-1] or price < self.swing_lows[-1]

    def get_fvg_zones(self):
        gaps = []
        for i in range(3, min(len(self.h1_candles), 30)):
            c1 = self.h1_candles[-i]
            c3 = self.h1_candles[-i - 2]
            if c1.low > c3.high:
                gaps.append({"low": c3.high, "high": c1.low, "type": "bullish"})
            if c1.high < c3.low:
                gaps.append({"low": c1.high, "high": c3.low, "type": "bearish"})
        return gaps

    def get_premium_discount(self):
        if not self.h1_candles:
            return "neutral"
        recent = self.h1_candles[-20:]
        eq = (max(c.high for c in recent) + min(c.low for c in recent)) / 2
        price = self.h1_candles[-1].close
        if eq > 0:
            if price > eq * 1.005:
                return "premium"
            if price < eq * 0.995:
                return "discount"
        return "equilibrium"

    def _find_order_blocks(self):
        self.order_blocks = self.get_order_blocks()

    def _find_fvg_zones(self):
        self.fvg_zones = self.get_fvg_zones()

    def _find_liquidity_zones(self):
        self.liquidity_zones = self.get_liquidity_zones()

    def _find_imbalance_zones(self):
        self.imbalance_zones = self.get_imbalance_zones()

    def get_technical_indicators(self):
        return {
            "volatility": self.volatility,
            "trend_strength": self.trend_strength,
            "momentum": self.momentum,
            "regime": self.regime
        }

    def build_state_vector(self):
        return np.array([
            self.volatility / 10 if self.volatility > 0 else 0,
            self.trend_strength,
            self.momentum / 10 if abs(self.momentum) > 0 else 0,
            1 if self.regime == "trending_up" else 0,
            1 if self.regime == "trending_down" else 0,
            1 if self.regime == "ranging" else 0,
            len(self.support_levels) / 5,
            len(self.resistance_levels) / 5,
        ])

    def get_market_summary(self):
        return f"Рынок: {self.regime}. Волатильность: {self.volatility:.2f}. Тренд: {self.trend_strength:.3f}"

# ============================================================
# RISK ENGINE
# ============================================================

class RiskEngine:
    def __init__(self, initial_balance: float = INITIAL_BALANCE, max_risk_percent: float = 2.0):
        self.initial_balance = initial_balance
        self.current_balance = initial_balance
        self.equity = initial_balance
        self.max_risk_percent = max_risk_percent
        self.daily_trades = 0
        self.max_daily_trades = 10
        self.daily_loss = 0.0
        self.max_daily_loss = initial_balance * 0.05
        self.consecutive_losses = 0
        self.max_consecutive_losses = 5
        self.risk_multiplier = 1.0
        self.last_reset_date = datetime.now().date()
        self.win_history = []

    def reset_daily_if_needed(self):
        today = datetime.now().date()
        if today != self.last_reset_date:
            self.daily_trades = 0
            self.daily_loss = 0.0
            self.last_reset_date = today

    def update_equity(self, new_equity: float):
        self.equity = new_equity
        if new_equity > self.current_balance:
            self.current_balance = new_equity

    def record_trade_result(self, profit: float):
        self.daily_trades += 1
        self.win_history.append(1 if profit > 0 else 0)
        if len(self.win_history) > 50:
            self.win_history.pop(0)
        if profit < 0:
            self.daily_loss += abs(profit)
            self.consecutive_losses += 1
        else:
            self.consecutive_losses = 0
        self.current_balance += profit
        self._update_risk_multiplier()

    def _update_risk_multiplier(self):
        if self.consecutive_losses >= 3:
            self.risk_multiplier = max(0.25, 1.0 - self.consecutive_losses * 0.25)
        else:
            growth = (self.current_balance / self.initial_balance - 1) * 0.5
            self.risk_multiplier = min(2.0, 1.0 + growth)

    def can_open_trade(self) -> bool:
        self.reset_daily_if_needed()
        if self.daily_trades >= self.max_daily_trades:
            return False
        if self.daily_loss >= self.max_daily_loss:
            return False
        if self.consecutive_losses >= self.max_consecutive_losses:
            return False
        return True

    def calculate_position_size(self, entry: float, stop_loss: float) -> float:
        return FIXED_LOT

    def get_win_rate(self):
        if not self.win_history:
            return 0.5
        return sum(self.win_history) / len(self.win_history)

    def calculate_kelly_fraction(self):
        wr = self.get_win_rate()
        if wr <= 0.5:
            return 0.01
        avg_win = 2.0
        avg_loss = 1.0
        if avg_loss == 0:
            return 0.01
        kelly = wr - (1 - wr) / (avg_win / avg_loss)
        return max(0.005, min(0.05, kelly * 0.5))

    def get_risk_report(self) -> Dict:
        return {
            "balance": self.current_balance,
            "daily_trades": self.daily_trades,
            "daily_loss": self.daily_loss,
            "risk_multiplier": self.risk_multiplier,
            "consecutive_losses": self.consecutive_losses,
            "win_rate": self.get_win_rate()
        }

class AdvancedRiskEngine(RiskEngine):
    def __init__(self, initial_balance: float = INITIAL_BALANCE):
        super().__init__(initial_balance)
        self.returns_history = []
        self.var_95 = 0.0
        self.portfolio_volatility = 0.0
        self.alerts = []

    def record_symbol_return(self, symbol: str, return_value: float):
        self.returns_history.append(return_value)
        if len(self.returns_history) > 252:
            self.returns_history.pop(0)

    def compute_var(self, confidence: float = 0.95) -> float:
        if len(self.returns_history) < 20:
            return 0.0
        sorted_returns = sorted(self.returns_history)
        index = int(len(sorted_returns) * (1 - confidence))
        self.var_95 = abs(sorted_returns[index])
        return self.var_95

    def compute_portfolio_volatility(self) -> float:
        if len(self.returns_history) < 2:
            return 0.0
        self.portfolio_volatility = float(np.std(self.returns_history))
        return self.portfolio_volatility

    def compute_portfolio_risk_score(self) -> float:
        score = self.portfolio_volatility * 10
        if self.initial_balance > 0:
            score += (self.daily_loss / self.initial_balance) * 100
        return min(score, 100.0)

    def get_full_risk_report(self) -> Dict:
        return {
            **self.get_risk_report(),
            "var_95": self.var_95,
            "portfolio_volatility": self.portfolio_volatility,
            "risk_score": self.compute_portfolio_risk_score()
        }

# ============================================================
# EXECUTION SAFETY LAYER
# ============================================================

class ExecutionSafetyLayer:
    def __init__(self):
        self.kill_switch_active = False
        self.cooldowns = {}
        self.daily_trades = 0
        self.max_daily_trades = 20
        self.last_reset = datetime.now().date()
        self.recent_signals = []
        self.blocked_symbols = []

    def activate_kill_switch(self, reason: str = "manual"):
        self.kill_switch_active = True
        logger.warning(f"KILL SWITCH: {reason}")

    def deactivate_kill_switch(self):
        self.kill_switch_active = False

    def is_in_cooldown(self, symbol: str) -> bool:
        return time.time() < self.cooldowns.get(symbol, 0)

    def set_cooldown(self, symbol: str, seconds: int = 300):
        self.cooldowns[symbol] = time.time() + seconds

    def _reset_daily_counter_if_needed(self):
        today = datetime.now().date()
        if today != self.last_reset:
            self.daily_trades = 0
            self.last_reset = today

    def increment_trade_count(self):
        self._reset_daily_counter_if_needed()
        self.daily_trades += 1

    def is_overtrading(self) -> bool:
        self._reset_daily_counter_if_needed()
        return self.daily_trades >= self.max_daily_trades

    def is_duplicate_signal(self, signal: TradeSignal, time_window: int = 60) -> bool:
        now = time.time()
        for s in self.recent_signals:
            if s["direction"] == signal.direction and now - s["time"] < time_window:
                return True
        return False

    def register_signal(self, signal: TradeSignal):
        self.recent_signals.append({"direction": signal.direction, "time": time.time()})
        if len(self.recent_signals) > 50:
            self.recent_signals = self.recent_signals[-50:]

    def has_conflicting_position(self, direction: Direction, positions: List[Position]) -> bool:
        for p in positions:
            if p.direction != direction:
                return True
        return False

    def is_execution_allowed(self, signal: TradeSignal, positions: List[Position]) -> bool:
        if self.kill_switch_active:
            return False
        if self.is_overtrading():
            return False
        if self.is_duplicate_signal(signal):
            return False
        if self.has_conflicting_position(signal.direction, positions):
            return False
        return True

    def on_trade_executed(self, signal: TradeSignal):
        self.increment_trade_count()
        self.register_signal(signal)

    def block_symbol(self, symbol: str, reason: str = ""):
        if symbol not in self.blocked_symbols:
            self.blocked_symbols.append(symbol)

    def unblock_symbol(self, symbol: str):
        if symbol in self.blocked_symbols:
            self.blocked_symbols.remove(symbol)

    def get_safety_report(self) -> Dict:
        return {
            "kill_switch": self.kill_switch_active,
            "daily_trades": self.daily_trades,
            "blocked_symbols": self.blocked_symbols
        }

# ============================================================
# PERSISTENCE LAYER
# ============================================================

class PersistenceLayer:
    def __init__(self, db_path: str = "aurum_state.db"):
        self.db_path = db_path
        self._lock = threading.Lock()
        self.operation_log = []
        self._init_persistence_db()

    def _init_persistence_db(self):
        try:
            conn = sqlite3.connect(self.db_path)
            conn.execute("""
                CREATE TABLE IF NOT EXISTS trades (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    ticket INTEGER, direction TEXT, entry REAL,
                    sl REAL, tp REAL, pattern TEXT, profit REAL,
                    open_time TEXT, close_time TEXT, regime TEXT, score REAL
                )
            """)
            conn.execute("""
                CREATE TABLE IF NOT EXISTS equity_curve (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    timestamp REAL, equity REAL
                )
            """)
            conn.execute("""
                CREATE TABLE IF NOT EXISTS saved_states (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT UNIQUE, data TEXT, saved_at TEXT
                )
            """)
            conn.commit()
            conn.close()
        except Exception as e:
            logger.error(f"Ошибка БД: {e}")

    def save_analytics_engine(self, engine):
        self._save_json("analytics", engine.get_full_report())

    def load_analytics_engine(self):
        return self._load_json("analytics")

    def save_advanced_risk_engine(self, engine):
        self._save_json("risk", engine.get_full_risk_report())

    def load_advanced_risk_engine(self):
        return self._load_json("risk")

    def save_signal_log(self, signal_log):
        self._save_json("signal_log", signal_log)

    def load_signal_log(self):
        return self._load_json("signal_log")

    def save_closed_trades_log(self, trades_log):
        self._save_json("closed_trades_log", trades_log)

    def load_closed_trades_log(self):
        return self._load_json("closed_trades_log")

    def save_all(self, components: Dict):
        for name, comp in components.items():
            if name == "analytics":
                self.save_analytics_engine(comp)
            elif name == "risk":
                self.save_advanced_risk_engine(comp)
            elif name == "signal_log":
                self.save_signal_log(comp)
            elif name == "closed_trades_log":
                self.save_closed_trades_log(comp)

    def load_all(self) -> Dict:
        return {
            "analytics": self.load_analytics_engine(),
            "risk": self.load_advanced_risk_engine(),
            "signal_log": self.load_signal_log(),
            "closed_trades_log": self.load_closed_trades_log()
        }

    def _save_json(self, name: str, data: Any):
        with self._lock:
            try:
                conn = sqlite3.connect(self.db_path)
                json_data = json.dumps(data, default=str)
                conn.execute(
                    "INSERT OR REPLACE INTO saved_states (name, data, saved_at) VALUES (?, ?, ?)",
                    (name, json_data, datetime.now().isoformat())
                )
                conn.commit()
                conn.close()
            except Exception as e:
                logger.error(f"Ошибка сохранения {name}: {e}")

    def _load_json(self, name: str) -> Any:
        with self._lock:
            try:
                conn = sqlite3.connect(self.db_path)
                cursor = conn.execute("SELECT data FROM saved_states WHERE name = ?", (name,))
                row = cursor.fetchone()
                conn.close()
                if row:
                    return json.loads(row[0])
                return {} if name != "signal_log" and name != "closed_trades_log" else []
            except Exception:
                return {} if name != "signal_log" and name != "closed_trades_log" else []

# ============================================================
# PERFORMANCE ANALYTICS
# ============================================================

class PerformanceAnalyticsEngine:
    def __init__(self):
        self.equity_curve = []
        self.trade_results = []
        self.win_rate = 0.0
        self.profit_factor = 0.0
        self.hourly_performance = {}
        self.daily_performance = {}

    def record_equity_point(self, equity: float, timestamp=None):
        self.equity_curve.append({"time": timestamp or time.time(), "equity": equity})

    def record_trade_result(self, result: Dict):
        self.trade_results.append(result)
        hour = result.get("hour", 0)
        day = result.get("day", "")
        if hour not in self.hourly_performance:
            self.hourly_performance[hour] = []
        self.hourly_performance[hour].append(result.get("profit", 0))
        if day not in self.daily_performance:
            self.daily_performance[day] = []
        self.daily_performance[day].append(result.get("profit", 0))
        self._update_ratios()

    def _update_ratios(self):
        if not self.trade_results:
            return
        wins = [t for t in self.trade_results if t.get("profit", 0) > 0]
        losses = [t for t in self.trade_results if t.get("profit", 0) <= 0]
        if len(self.trade_results) > 0:
            self.win_rate = len(wins) / len(self.trade_results)
        total_profit = sum(t.get("profit", 0) for t in wins)
        total_loss = abs(sum(t.get("profit", 0) for t in losses))
        self.profit_factor = total_profit / total_loss if total_loss > 0 else float('inf')

    def get_best_trading_hours(self):
        if not self.hourly_performance:
            return []
        return sorted(self.hourly_performance,
                      key=lambda h: sum(self.hourly_performance[h]) / max(1, len(self.hourly_performance[h])),
                      reverse=True)[:3]

    def get_worst_trading_hours(self):
        if not self.hourly_performance:
            return []
        return sorted(self.hourly_performance,
                      key=lambda h: sum(self.hourly_performance[h]) / max(1, len(self.hourly_performance[h])))[:3]

    def filter_by_day_of_week(self, day):
        return self.daily_performance.get(day, [])

    def get_full_report(self) -> Dict:
        return {
            "total_trades": len(self.trade_results),
            "win_rate": self.win_rate,
            "profit_factor": self.profit_factor,
            "best_hours": self.get_best_trading_hours(),
            "worst_hours": self.get_worst_trading_hours()
        }

    def get_equity_curve(self):
        return self.equity_curve

# ============================================================
# EVENT BUS
# ============================================================

class EventBus:
    _instance = None

    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance._subscribers = {}
            cls._instance._lock = threading.Lock()
            cls._instance._running = False
            cls._instance._queue = deque()
        return cls._instance

    def subscribe(self, event: str, callback: Callable):
        with self._lock:
            if event not in self._subscribers:
                self._subscribers[event] = []
            self._subscribers[event].append(callback)

    def publish(self, event: str, data: Any = None):
        self._queue.append((event, data))

    def publish_sync(self, event: str, data: Any = None):
        self._dispatch(event, data)

    def _dispatch(self, event: str, data: Any):
        with self._lock:
            for cb in self._subscribers.get(event, []):
                try:
                    cb(data)
                except Exception as e:
                    logger.error(f"Ошибка EventBus: {e}")

    def start(self):
        self._running = True
        threading.Thread(target=self._process_loop, daemon=True).start()

    def stop(self):
        self._running = False

    def _process_loop(self):
        while self._running:
            if self._queue:
                event, data = self._queue.popleft()
                self._dispatch(event, data)
            else:
                time.sleep(0.01)

# ============================================================
# POSITION TRACKER
# ============================================================

class PositionTracker:
    def __init__(self):
        self.positions = {}
        self.alerts = []

    def update_position(self, ticket: int, data: Dict):
        self.positions[ticket] = data

    def remove_position(self, ticket: int):
        if ticket in self.positions:
            del self.positions[ticket]

    def get_positions_summary(self):
        return [
            {"ticket": t, "direction": p.get("direction"),
             "entry": p.get("entry"), "pnl": p.get("profit", 0)}
            for t, p in self.positions.items()
        ]

# ============================================================
# DECISION ENGINE
# ============================================================

class DecisionEngine:
    def __init__(self):
        self.cooldowns = {}
        self.stats = {"decisions_made": 0, "trades_opened": 0}

    def is_in_cooldown(self, symbol: str) -> bool:
        return time.time() < self.cooldowns.get(symbol, 0)

    def set_cooldown(self, symbol: str, seconds: int = 300):
        self.cooldowns[symbol] = time.time() + seconds

    def make_decision(self, signal: TradeSignal, risk_engine: RiskEngine) -> bool:
        self.stats["decisions_made"] += 1
        if not risk_engine.can_open_trade():
            return False
        if signal.confidence < 0.6:
            return False
        self.stats["trades_opened"] += 1
        return True

    def get_stats(self) -> Dict:
        return self.stats

# ============================================================
# CHAT ENGINE
# ============================================================

class ChatEngine:
    def __init__(self):
        self.history = []
        self.max_history = 50

    def _format_number(self, value: float, decimals: int = 2) -> str:
        return f"{value:.{decimals}f}"

    def generate_response(self, message: str, context: Dict = None) -> str:
        self.history.append({"role": "user", "content": message})
        msg = message.lower().strip()
        ctx = context or {}

        if msg.startswith('/'):
            response = self._handle_command(msg, ctx)
        else:
            response = self._smart_reply(msg, ctx)

        self.history.append({"role": "assistant", "content": response})
        if len(self.history) > self.max_history:
            self.history = self.history[-self.max_history:]
        return response

    def _handle_command(self, cmd: str, ctx: Dict) -> str:
        parts = cmd.split()
        command = parts[0].lower()

        if command == '/status':
            s = ctx.get('status', {})
            return (f"📊 Режим: {s.get('mode','N/A')} | "
                    f"Сессия: {'✅' if s.get('session_active') else '❌'} | "
                    f"Позиций: {s.get('open_positions',0)} | "
                    f"PnL: {s.get('daily_pnl',0):.2f}$")

        if command == '/positions':
            pos = ctx.get('positions', [])
            if not pos:
                return "📭 Позиций нет."
            lines = []
            for p in pos:
                lines.append(f"• {p['direction']} | Вход: {p['entry']:.2f} | PnL: {p.get('pnl',0):.2f}$")
            return "📋 " + "\n".join(lines)

        if command == '/signal':
            s = ctx.get('last_signal')
            if not s:
                return "🔕 Сигналов нет."
            return (f"🔔 {s['direction']} | {s['pattern']} | "
                    f"R={s['r_ratio']:.1f} | Скор: {s.get('score','?')}")

        if command == '/help':
            return "📚 /status | /positions | /signal | /mode [aurum|manual] | /weekly | /report | /help"

        if command == '/weekly':
            r = ctx.get('weekly_report', {})
            return (f"📅 Неделя: {r.get('trades',0)} сделок, "
                    f"PnL: {r.get('pnl',0):.2f}$, "
                    f"WR: {r.get('win_rate',0)*100:.0f}%")

        if command == '/report':
            r = ctx.get('analytics', {})
            return (f"📊 Сделок: {r.get('total_trades',0)}, "
                    f"WR: {r.get('win_rate',0)*100:.0f}%, "
                    f"PF: {r.get('profit_factor',0):.1f}")

        return f"❓ {command} — неизвестно. /help для списка."

    def _smart_reply(self, msg: str, ctx: Dict) -> str:
        if any(w in msg for w in ['привет', 'здравствуй', 'hello', 'hi']):
            return "👋 Привет! Я AURUM V3.0. Торгую XAU/USD без стоп-лосса, с адаптивным тейк-профитом минимум $10."

        if any(w in msg for w in ['стратеги', 'aurum', 'как работаешь', 'логика']):
            return ("📖 AURUM V3.0: пробой консолидации на H1 в сторону тренда H4, "
                    "подтверждённый объёмом и RSI дивергенцией. "
                    "Без стоп-лосса. Тейк-профит адаптивный (бот считает сам), минимум $10 прибыли с лота 0.02.")

        if any(w in msg for w in ['золото', 'xau', 'gold', 'рынок']):
            session = '✅' if ctx.get('session_active') else '❌'
            regime = ctx.get('status', {}).get('regime', '?')
            return f"📊 XAU/USD. Сессия: {session}. Режим: {regime}."

        replies = [
            "🤔 Спрашивай — я здесь!",
            "Интересно! Расскажи подробнее.",
            "Я тут чтобы помочь с торговлей золотом.",
            "Хочешь посмотреть сигналы? Напиши /signal",
        ]
        return random.choice(replies)

# ============================================================
# AURUM V3.0 STRATEGY ENGINE
# ============================================================

class AurumStrategyEngine:
    def __init__(self):
        self.name = "AURUM_V3.0"
        self.symbol = SYMBOL
        self.h4_candles = []
        self.h1_candles = []
        self.m15_candles = []
        self.ema20_h4 = 0.0
        self.ema20_h1 = 0.0
        self.atr14_h1 = 0.0
        self.swing_highs_h4 = []
        self.swing_lows_h4 = []
        self.news_filter = NewsFilter()

    def is_active_session(self):
        hour = datetime.utcnow().hour
        return (LONDON_START <= hour < LONDON_END) or (NY_START <= hour < NY_END)

    def get_session_priority(self):
        hour = datetime.utcnow().hour
        if NY_START <= hour < LONDON_END:
            return 2
        if LONDON_START <= hour < NY_START or LONDON_END <= hour < NY_END:
            return 1
        return 0

    def _calc_ema(self, candles, period):
        if len(candles) < period:
            return candles[-1].close if candles else 0.0
        closes = [c.close for c in candles]
        multiplier = 2.0 / (period + 1)
        ema = sum(closes[:period]) / period
        for price in closes[period:]:
            ema = (price - ema) * multiplier + ema
        return ema

    def _find_swing_points(self, candles, lookback=2):
        highs, lows = [], []
        for i in range(lookback, len(candles) - lookback):
            c = candles[i]
            left_high = all(c.high > candles[i - j].high for j in range(1, lookback + 1))
            right_high = all(c.high > candles[i + j].high for j in range(1, lookback + 1))
            if left_high and right_high:
                highs.append(c.high)
            left_low = all(c.low < candles[i - j].low for j in range(1, lookback + 1))
            right_low = all(c.low < candles[i + j].low for j in range(1, lookback + 1))
            if left_low and right_low:
                lows.append(c.low)
        return highs, lows

    def get_h4_context(self):
        if len(self.h4_candles) < 20:
            return Direction.NONE
        self.ema20_h4 = self._calc_ema(self.h4_candles, 20)
        self.swing_highs_h4, self.swing_lows_h4 = self._find_swing_points(self.h4_candles)
        price = self.h4_candles[-1].close

        if price > self.ema20_h4 and len(self.swing_highs_h4) >= 2 and len(self.swing_lows_h4) >= 2:
            if self.swing_highs_h4[-1] > self.swing_highs_h4[-2] and self.swing_lows_h4[-1] > self.swing_lows_h4[-2]:
                return Direction.BUY
        if price < self.ema20_h4 and len(self.swing_highs_h4) >= 2 and len(self.swing_lows_h4) >= 2:
            if self.swing_lows_h4[-1] < self.swing_lows_h4[-2] and self.swing_highs_h4[-1] < self.swing_highs_h4[-2]:
                return Direction.SELL
        return Direction.NONE

    def _calc_atr(self, candles, period=14):
        if len(candles) < period + 1:
            return candles[-1].high - candles[-1].low if candles else 0.0
        tr_list = []
        for i in range(1, len(candles)):
            c = candles[i]
            p = candles[i - 1]
            tr = max(c.high - c.low, abs(c.high - p.close), abs(c.low - p.close))
            tr_list.append(tr)
        return sum(tr_list[-period:]) / period

    def _calc_rsi(self, candles, period=14):
        if len(candles) < period + 1:
            return 50.0
        closes = [c.close for c in candles]
        gains, losses = [], []
        for i in range(1, len(closes)):
            diff = closes[i] - closes[i - 1]
            gains.append(max(diff, 0))
            losses.append(max(-diff, 0))
        avg_gain = sum(gains[-period:]) / period
        avg_loss = sum(losses[-period:]) / period
        if avg_loss == 0:
            return 100.0
        return 100.0 - (100.0 / (1.0 + avg_gain / avg_loss))

    def detect_T1_inside_bar(self):
        if len(self.h1_candles) < 3:
            return None
        context = self.get_h4_context()
        if context == Direction.NONE:
            return None
        self.atr14_h1 = self._calc_atr(self.h1_candles)
        threshold = self.get_mb_threshold()

        for i in range(len(self.h1_candles) - 2, 1, -1):
            mb = self.h1_candles[i - 1]
            ib = self.h1_candles[i]
            mb_range = mb.high - mb.low
            if mb_range < threshold * self.atr14_h1:
                continue
            if ib.high > mb.high or ib.low < mb.low:
                continue
            inner_count = 1
            for j in range(i - 1, max(i - 4, -1), -1):
                c = self.h1_candles[j]
                if c.high <= mb.high and c.low >= mb.low:
                    inner_count += 1
                else:
                    break
            if inner_count > 4:
                continue
            current = self.h1_candles[-1]
            if context == Direction.BUY and current.close > mb.high:
                return self._build_signal(Direction.BUY, current.close, mb.low, mb.high, "T1_InsideBar")
            if context == Direction.SELL and current.close < mb.low:
                return self._build_signal(Direction.SELL, current.close, mb.high, mb.low, "T1_InsideBar")
        return None

    def detect_T2_narrow_range(self):
        if len(self.h1_candles) < 6:
            return None
        context = self.get_h4_context()
        if context == Direction.NONE:
            return None

        for end_idx in range(len(self.h1_candles) - 1, 4, -1):
            for length in range(3, 6):
                start_idx = end_idx - length + 1
                if start_idx < 0:
                    continue
                series = self.h1_candles[start_idx:end_idx + 1]
                ranges = [c.high - c.low for c in series]
                if not all(ranges[j] <= ranges[j - 1] for j in range(1, len(ranges))):
                    continue
                nrh = max(c.high for c in series)
                nrl = min(c.low for c in series)
                current = self.h1_candles[-1]
                if context == Direction.BUY and current.close > nrh:
                    return self._build_signal(Direction.BUY, current.close, nrl, nrh, "T2_NarrowRange")
                if context == Direction.SELL and current.close < nrl:
                    return self._build_signal(Direction.SELL, current.close, nrh, nrl, "T2_NarrowRange")
        return None

    def detect_T3_ema_pullback(self):
        if len(self.h1_candles) < 20:
            return None
        context = self.get_h4_context()
        if context == Direction.NONE:
            return None
        self.ema20_h1 = self._calc_ema(self.h1_candles, 20)
        zone = 0.5

        for i in range(-3, 0):
            c = self.h1_candles[i]
            if context == Direction.BUY:
                if c.low <= self.ema20_h1 + zone and c.close > self.ema20_h1:
                    body_bottom = min(c.open, c.close)
                    candle_range = c.high - c.low
                    if candle_range > 0 and body_bottom - c.low > candle_range * 0.3:
                        tp_target = self.swing_highs_h4[-1] if self.swing_highs_h4 else c.close + 2 * self.atr14_h1
                        return self._build_signal(Direction.BUY, c.close, c.low - zone, tp_target, "T3_EMAPullback")
            else:
                if c.high >= self.ema20_h1 - zone and c.close < self.ema20_h1:
                    body_top = max(c.open, c.close)
                    candle_range = c.high - c.low
                    if candle_range > 0 and c.high - body_top > candle_range * 0.3:
                        tp_target = self.swing_lows_h4[-1] if self.swing_lows_h4 else c.close - 2 * self.atr14_h1
                        return self._build_signal(Direction.SELL, c.close, c.high + zone, tp_target, "T3_EMAPullback")
        return None

    def detect_T4_fake_breakout(self):
        if len(self.h1_candles) < 4:
            return None
        context = self.get_h4_context()
        if context == Direction.NONE:
            return None

        current = self.h1_candles[-1]
        prev = self.h1_candles[-2]
        prev2 = self.h1_candles[-3]

        for level in self.swing_highs_h4 + self.swing_lows_h4:
            if prev2.close < level < prev.close and current.close < level and context == Direction.SELL:
                return self._build_signal(Direction.SELL, current.close, prev.high, level, "T4_FakeBreakout")
            if prev2.close > level > prev.close and current.close > level and context == Direction.BUY:
                return self._build_signal(Direction.BUY, current.close, prev.low, level, "T4_FakeBreakout")
        return None

    def detect_T5_momentum_breakout(self):
        if len(self.h1_candles) < 5:
            return None
        context = self.get_h4_context()
        if context == Direction.NONE:
            return None

        last3 = self.h1_candles[-3:]

        if context == Direction.BUY:
            if all(c.close > c.open for c in last3) and all(last3[i].close > last3[i - 1].close for i in range(1, 3)):
                if last3[-1].tick_volume > last3[-2].tick_volume > last3[-3].tick_volume:
                    return self._build_signal(Direction.BUY, last3[-1].close, last3[0].low,
                                              last3[-1].high + self._calc_atr(self.h1_candles),
                                              "T5_MomentumBreakout")
        else:
            if all(c.close < c.open for c in last3) and all(last3[i].close < last3[i - 1].close for i in range(1, 3)):
                if last3[-1].tick_volume > last3[-2].tick_volume > last3[-3].tick_volume:
                    return self._build_signal(Direction.SELL, last3[-1].close, last3[0].high,
                                              last3[-1].low - self._calc_atr(self.h1_candles),
                                              "T5_MomentumBreakout")
        return None

    def detect_T6_opening_range_breakout(self):
        now = datetime.utcnow()
        if now.hour < 8 or now.hour > 16:
            return None
        context = self.get_h4_context()
        if context == Direction.NONE:
            return None

        london_open_candles = [c for c in self.h1_candles if c.time.hour == 7]
        if not london_open_candles:
            return None

        open_candle = london_open_candles[-1]
        range_high = open_candle.high
        range_low = open_candle.low
        current = self.h1_candles[-1]
        atr_val = self._calc_atr(self.h1_candles)

        if context == Direction.BUY and current.close > range_high:
            return self._build_signal(Direction.BUY, current.close, range_low, range_high + atr_val, "T6_ORB")
        if context == Direction.SELL and current.close < range_low:
            return self._build_signal(Direction.SELL, current.close, range_high, range_low - atr_val, "T6_ORB")
        return None

    def check_volume_confirmation(self):
        if len(self.h1_candles) < 6:
            return False
        avg_vol = sum(c.tick_volume for c in self.h1_candles[-6:-1]) / 5
        return self.h1_candles[-1].tick_volume > avg_vol

    def check_rsi_divergence(self, direction):
        if len(self.m15_candles) < 20:
            return False, 0.0
        window = self.m15_candles[-15:]
        rsi_vals = [self._calc_rsi(window[max(0, i - 7):i + 1]) for i in range(7, len(window))]
        prices = [c.close for c in window[7:]]
        best_strength = 0.0

        if direction == Direction.BUY:
            for i in range(1, len(prices) - 1):
                for j in range(i + 1, len(prices)):
                    if prices[j] < prices[i] and rsi_vals[j] > rsi_vals[i]:
                        strength = (rsi_vals[j] - rsi_vals[i]) / 30.0
                        best_strength = max(best_strength, min(strength, 1.0))
        else:
            for i in range(1, len(prices) - 1):
                for j in range(i + 1, len(prices)):
                    if prices[j] > prices[i] and rsi_vals[j] < rsi_vals[i]:
                        strength = (rsi_vals[i] - rsi_vals[j]) / 30.0
                        best_strength = max(best_strength, min(strength, 1.0))

        return best_strength > 0.3, best_strength

    def check_target_sufficiency(self, signal):
        if not self.swing_highs_h4 or not self.swing_lows_h4:
            signal.r_ratio = 2.0
            return True

        if signal.direction == Direction.BUY:
            targets = [h for h in self.swing_highs_h4 if h > signal.entry_price]
            if not targets:
                signal.r_ratio = 2.0
                return True
            distance = min(targets) - signal.entry_price
            risk = signal.entry_price - signal.stop_loss if signal.stop_loss > 0 else signal.entry_price * 0.01
        else:
            targets = [l for l in self.swing_lows_h4 if l < signal.entry_price]
            if not targets:
                signal.r_ratio = 2.0
                return True
            distance = signal.entry_price - min(targets, key=lambda x: signal.entry_price - x)
            risk = signal.stop_loss - signal.entry_price if signal.stop_loss > signal.entry_price else signal.entry_price * 0.01

        if risk <= 0:
            signal.r_ratio = 2.0
            return True
        signal.r_ratio = distance / risk
        return signal.r_ratio >= 1.5

    def check_friday_risk(self):
        return datetime.utcnow().weekday() == 4

    def check_monday_liquidity(self):
        now = datetime.utcnow()
        return now.weekday() == 0 and now.hour < 8

    def check_correlation(self, dxy_change=0.0):
        if dxy_change > 0.1:
            return "bearish_gold"
        if dxy_change < -0.1:
            return "bullish_gold"
        return "neutral"

    def _build_signal(self, direction, entry, stop_level, breakout_level, pattern):
        """
        Сигнал БЕЗ стоп-лосса.
        TP рассчитывается адаптивно:
        - Минимум $10 прибыли с лота 0.02 (500 пунктов)
        - Максимум — до ближайшего H4 уровня
        - Бот сам оптимизирует по ATR
        """
        atr = self._calc_atr(self.h1_candles, 14)

        # Расчёт TP: минимальная прибыль $10 с лота 0.02 = 500 пунктов
        min_tp_points = MIN_PROFIT_DOLLARS / (FIXED_LOT * 100)

        # Адаптивный TP по ATR
        atr_tp = atr * 3.0

        # Выбираем максимум из минимального TP и ATR-based TP
        base_tp_points = max(min_tp_points, atr_tp)

        # Корректируем до H4 уровня
        if direction == Direction.BUY:
            tp = entry + base_tp_points
            if self.swing_highs_h4:
                targets = [h for h in self.swing_highs_h4 if h > entry + min_tp_points]
                if targets:
                    tp = min(entry + base_tp_points, min(targets) - 0.2)
        else:
            tp = entry - base_tp_points
            if self.swing_lows_h4:
                targets = [l for l in self.swing_lows_h4 if l < entry - min_tp_points]
                if targets:
                    tp = max(entry - base_tp_points, min(targets, key=lambda x: entry - x) + 0.2)

        # Гарантируем минимум $10
        if direction == Direction.BUY:
            tp = max(tp, entry + min_tp_points)
        else:
            tp = min(tp, entry - min_tp_points)

        signal = TradeSignal(
            direction=direction,
            entry_price=entry,
            stop_loss=0.0,  # БЕЗ СТОП-ЛОССА
            take_profit=tp,
            pattern=pattern,
            confidence=0.8,
            r_ratio=0.0  # Без стопа R-ratio не имеет смысла
        )
        return signal

    def score_signal(self, signal, volume_ratio, divergence_strength):
        score = 0.0

        pattern_scores = {
            "T1_InsideBar": 3.0, "T2_NarrowRange": 2.0, "T3_EMAPullback": 1.0,
            "T4_FakeBreakout": 3.5, "T5_MomentumBreakout": 2.5, "T6_ORB": 2.0
        }
        score += pattern_scores.get(signal.pattern, 1.0)

        if volume_ratio > 2.0:
            score += 2.0
        elif volume_ratio > 1.5:
            score += 1.0

        if divergence_strength > 0.8:
            score += 2.0
        elif divergence_strength > 0.5:
            score += 1.0

        score += self.get_session_confidence()

        return max(0.0, min(9.0, score))

    def trail_stop(self, position, current_price, trail_distance=1.5):
        if position.direction == Direction.BUY:
            new_sl = current_price - trail_distance
            if new_sl > position.stop_loss:
                position.stop_loss = new_sl
                return True
        else:
            new_sl = current_price + trail_distance
            if new_sl < position.stop_loss:
                position.stop_loss = new_sl
                return True
        return False

    def get_mb_threshold(self):
        if len(self.h1_candles) < 20:
            return 0.7
        atr_now = self._calc_atr(self.h1_candles, 14)
        atr_old = self._calc_atr(self.h1_candles[:-20], 14) if len(self.h1_candles) > 20 else atr_now
        if atr_old > 0 and atr_now / atr_old < 0.7:
            return 0.5
        return 0.7

    def filter_weak_levels(self, levels, min_touches=3):
        if not self.h1_candles:
            return levels
        strong = []
        for l in levels:
            touches = sum(1 for c in self.h1_candles[-50:]
                          if abs(c.high - l) < 0.5 or abs(c.low - l) < 0.5)
            if touches >= min_touches:
                strong.append(l)
        return strong

    def get_volume_at_level(self, level, tolerance=0.5):
        return sum(c.tick_volume for c in self.h1_candles[-100:] if abs(c.close - level) < tolerance)

    def get_session_confidence(self):
        return 1.0 if self.get_session_priority() == 2 else 0.0

    def get_strongest_level(self, levels):
        if not levels:
            return None
        return max(levels, key=lambda l: self.get_volume_at_level(l))

    def get_atr_percentile(self):
        if len(self.h1_candles) < 100:
            return 50
        atrs = []
        for i in range(len(self.h1_candles) - 14):
            window = self.h1_candles[i:i + 14]
            atrs.append(self._calc_atr(window, 14))
        if not atrs:
            return 50
        current = self._calc_atr(self.h1_candles, 14)
        count_below = sum(1 for a in atrs if a < current)
        return count_below / len(atrs) * 100

    def calculate_dynamic_lot(self, base_lot, volatility):
        percentile = self.get_atr_percentile()
        if percentile > 80:
            return base_lot * 0.5
        if percentile < 20:
            return base_lot * 1.5
        return base_lot

    def get_optimal_tp(self, entry, direction):
        atr = self._calc_atr(self.h1_candles, 14)
        min_tp_points = MIN_PROFIT_DOLLARS / (FIXED_LOT * 100)
        atr_tp = atr * 3.0
        tp_points = max(min_tp_points, atr_tp)
        if direction == Direction.BUY:
            return entry + tp_points
        return entry - tp_points

    def get_optimal_sl(self, entry, direction):
        return 0.0  # Без стоп-лосса

    def detect_divergence_strength(self, direction):
        _, strength = self.check_rsi_divergence(direction)
        return strength

    def get_volume_climax(self):
        if len(self.h1_candles) < 20:
            return False
        vols = [c.tick_volume for c in self.h1_candles[-20:]]
        mean = np.mean(vols)
        std = np.std(vols)
        if std == 0:
            return False
        return vols[-1] > mean + 3 * std

    def detect_absorption(self):
        if len(self.h1_candles) < 2:
            return None
        c = self.h1_candles[-1]
        body = abs(c.close - c.open)
        bodies = []
        for i in range(-20, -1):
            bodies.append(abs(self.h1_candles[i].close - self.h1_candles[i].open))
        if not bodies:
            return None
        avg_body = np.mean(bodies)
        vols = [x.tick_volume for x in self.h1_candles[-20:-1]]
        if not vols:
            return None
        avg_vol = np.mean(vols)
        if avg_body > 0 and c.tick_volume > avg_vol * 2 and body < avg_body * 0.5:
            return "BUY" if c.close > c.open else "SELL"
        return None

    def get_swing_point_age(self):
        if not self.h4_candles:
            return 999
        last_swing_time = self.h4_candles[-1].time
        for c in reversed(self.h4_candles):
            if c.high in self.swing_highs_h4 or c.low in self.swing_lows_h4:
                last_swing_time = c.time
                break
        return (datetime.utcnow() - last_swing_time).total_seconds() / 3600

    def get_regime_confidence(self):
        if abs(self._get_trend_strength()) > 0.05:
            return 0.9
        if abs(self._get_trend_strength()) > 0.02:
            return 0.6
        return 0.3

    def _get_trend_strength(self):
        if len(self.h4_candles) < 20:
            return 0.0
        closes = [c.close for c in self.h4_candles[-20:]]
        x = list(range(20))
        try:
            slope = np.polyfit(x, closes, 1)[0]
            return (slope / closes[-1]) * 100 if closes[-1] != 0 else 0.0
        except (np.linalg.LinAlgError, ValueError):
            return 0.0

    def find_signal(self, h4, h1, m15):
        self.h4_candles = h4 or []
        self.h1_candles = h1 or []
        self.m15_candles = m15 or []

        if self.news_filter.is_news_near():
            return None
        if self.check_monday_liquidity():
            return None
        if not self.is_active_session():
            return None
        if self.get_h4_context() == Direction.NONE:
            return None

        signal = None
        detectors = [
            self.detect_T1_inside_bar,
            self.detect_T2_narrow_range,
            self.detect_T3_ema_pullback,
            self.detect_T4_fake_breakout,
            self.detect_T5_momentum_breakout,
            self.detect_T6_opening_range_breakout,
        ]
        for detector in detectors:
            signal = detector()
            if signal:
                break

        if signal:
            if not self.check_volume_confirmation():
                return None
            has_div, div_strength = self.check_rsi_divergence(signal.direction)
            if not has_div:
                return None
            # check_target_sufficiency не нужен без стопа, просто ставим r_ratio = 0
            signal.r_ratio = 0.0

            avg_vol = sum(c.tick_volume for c in self.h1_candles[-6:-1]) / 5 if len(self.h1_candles) >= 6 else 1
            vol_ratio = self.h1_candles[-1].tick_volume / avg_vol if avg_vol > 0 else 1
            score = self.score_signal(signal, vol_ratio, div_strength)
            signal.confidence = 0.6 + score * 0.04
            return signal

        return None

# ============================================================
# MASTER AI
# ============================================================

class MasterAI:
    def __init__(self):
        self.mt5 = MT5Integration()
        self.market_intel = MarketIntelligence()
        self.risk_engine = AdvancedRiskEngine(initial_balance=INITIAL_BALANCE)
        self.aurum_engine = AurumStrategyEngine()
        self.position_tracker = PositionTracker()
        self.analytics_engine = PerformanceAnalyticsEngine()
        self.chat_engine = ChatEngine()
        self.decision_engine = DecisionEngine()
        self.event_bus = EventBus()
        self.persistence = PersistenceLayer()
        self.safety_layer = ExecutionSafetyLayer()

        self.mode = StrategyMode.AURUM_V3
        self.is_running = False
        self.positions: List[Position] = []
        self.last_signal: Optional[TradeSignal] = None
        self.signals_today = 0
        self.daily_pnl = 0.0
        self.ticket_counter = 1000
        self.signal_log = []
        self.closed_trades_log = []
        self.weekly_pnl = 0.0
        self.weekly_trades = 0
        self.last_weekly_reset = datetime.now()

        self.h4_candles = []
        self.h1_candles = []
        self.m15_candles = []

    def initialize(self):
        logger.info("=" * 50)
        logger.info("Инициализация AURUM V3.0")
        logger.info(f"Символ: {SYMBOL} | Лот: {FIXED_LOT} | Баланс: ${INITIAL_BALANCE}")
        logger.info(f"TP: адаптивный, минимум ${MIN_PROFIT_DOLLARS} | Стоп: ОТКЛЮЧЕН")
        logger.info("=" * 50)
        self.mt5.connect()
        self._load_state_from_db()
        self.event_bus.start()
        logger.info("Бот готов к работе")

    def _load_state_from_db(self):
        saved = self.persistence.load_all()
        if saved:
            self.signal_log = saved.get("signal_log", [])
            self.closed_trades_log = saved.get("closed_trades_log", [])
            logger.info("Сохранённое состояние загружено")

    def update_market_data(self):
        try:
            import MetaTrader5 as mt5_module
            self.h4_candles = self.mt5.get_rates(
                SYMBOL,
                mt5_module.TIMEFRAME_H4 if hasattr(mt5_module, 'TIMEFRAME_H4') else 16388,
                100
            )
            self.h1_candles = self.mt5.get_rates(
                SYMBOL,
                mt5_module.TIMEFRAME_H1 if hasattr(mt5_module, 'TIMEFRAME_H1') else 16385,
                100
            )
            self.m15_candles = self.mt5.get_rates(
                SYMBOL,
                mt5_module.TIMEFRAME_M15 if hasattr(mt5_module, 'TIMEFRAME_M15') else 15,
                100
            )
            self.market_intel.update(self.h4_candles, self.h1_candles, self.m15_candles)
        except Exception as e:
            logger.error(f"Ошибка обновления данных: {e}")

    def think_and_decide(self):
        self.update_market_data()
        if self.mode == StrategyMode.MANUAL:
            return

        signal = self.aurum_engine.find_signal(self.h4_candles, self.h1_candles, self.m15_candles)
        if signal is None:
            return

        self.last_signal = signal

        avg_vol = sum(c.tick_volume for c in self.h1_candles[-6:-1]) / 5 if len(self.h1_candles) >= 6 else 1
        vol_ratio = self.h1_candles[-1].tick_volume / avg_vol if avg_vol > 0 else 1
        _, div_strength = self.aurum_engine.check_rsi_divergence(signal.direction)
        score = self.aurum_engine.score_signal(signal, vol_ratio, div_strength)

        self.log_signal_quality(signal, score)

        if score <= 2:
            logger.info(f"Сигнал отклонён: скор {score:.0f}/9 (порог 2)")
            return

        if self.filter_by_day_of_week() == "skip":
            logger.info("Сигнал отклонён: неблагоприятный день недели")
            return

        if self.decision_engine.make_decision(signal, self.risk_engine):
            self.execute_trade(signal, score)

    def execute_trade(self, signal: TradeSignal, score: float = 5):
        if not self.safety_layer.is_execution_allowed(signal, self.positions):
            logger.warning("Сделка отклонена защитой")
            return None

        lot = FIXED_LOT

        # Прибыль в долларах с текущим TP
        profit_points = abs(signal.take_profit - signal.entry_price)
        profit_dollars = profit_points * lot * 100

        # Ордер БЕЗ стоп-лосса, с тейк-профитом
        ticket = self.mt5.open_order(
            SYMBOL,
            "BUY" if signal.direction == Direction.BUY else "SELL",
            lot,
            sl=0.0,  # БЕЗ СТОП-ЛОССА
            tp=signal.take_profit,
            comment=f"AURUM_{signal.pattern}"
        )

        if ticket is None:
            ticket = self.ticket_counter
            self.ticket_counter += 1

        position = Position(
            ticket=ticket,
            direction=signal.direction,
            entry_price=signal.entry_price,
            stop_loss=0.0,  # БЕЗ СТОП-ЛОССА
            take_profit=signal.take_profit,
            volume=lot,
            open_time=datetime.now(),
            pattern=signal.pattern
        )

        self.positions.append(position)
        self.signals_today += 1
        self.safety_layer.on_trade_executed(signal)
        self.position_tracker.update_position(ticket, {
            "direction": signal.direction.name,
            "entry": signal.entry_price,
            "sl": 0.0,
            "tp": signal.take_profit
        })

        logger.info(f"✅ #{ticket}: {signal.direction.name} {signal.pattern} | "
                     f"Лот: {lot} | Скор: {score:.0f}/9 | "
                     f"Вход: {signal.entry_price:.2f} | TP: {signal.take_profit:.2f} | "
                     f"Прибыль: ~${profit_dollars:.2f} | SL: ОТКЛЮЧЕН")
        return position

    def manage_open_positions(self):
        for pos in self.positions[:]:
            price = self.mt5._get_real_price(SYMBOL, "BUY" if pos.direction == Direction.BUY else "SELL")
            if price == 0:
                continue

            if pos.direction == Direction.BUY:
                pos.highest_price = max(pos.highest_price, price)
                tp_hit = price >= pos.take_profit
            else:
                pos.lowest_price = min(pos.lowest_price, price)
                tp_hit = price <= pos.take_profit

            if tp_hit:
                if pos.direction == Direction.BUY:
                    profit_per_unit = price - pos.entry_price
                else:
                    profit_per_unit = pos.entry_price - price
                realized = profit_per_unit * pos.volume * 100
                self._close_full_position(pos, price, "TP")
                self.daily_pnl += realized
                self.weekly_pnl += realized

    def _close_full_position(self, pos: Position, price: float, reason: str):
        self.mt5.close_position(pos.ticket)
        if pos.direction == Direction.BUY:
            profit_per_unit = price - pos.entry_price
        else:
            profit_per_unit = pos.entry_price - price
        realized = profit_per_unit * pos.volume * 100
        self.daily_pnl += realized
        self.weekly_pnl += realized
        self.weekly_trades += 1

        self.positions.remove(pos)
        self.position_tracker.remove_position(pos.ticket)
        self.risk_engine.record_trade_result(realized)
        self.analytics_engine.record_trade_result({
            "ticket": pos.ticket,
            "profit": realized,
            "pattern": pos.pattern,
            "hour": datetime.now().hour,
            "day": datetime.now().strftime("%A"),
            "regime": self.market_intel.get_regime()
        })
        self.replay_closed_trades(pos, realized)
        logger.info(f"{reason} #{pos.ticket}: +{realized:.2f}$")

    def daily_reset_stats(self):
        now = datetime.now()
        if now.hour == 0 and now.minute == 0:
            self.signals_today = 0
            self.daily_pnl = 0.0

    def weekly_report(self):
        if (datetime.now() - self.last_weekly_reset).days >= 7:
            report = {
                "trades": self.weekly_trades,
                "pnl": self.weekly_pnl,
                "win_rate": self.risk_engine.get_win_rate()
            }
            self.weekly_trades = 0
            self.weekly_pnl = 0.0
            self.last_weekly_reset = datetime.now()
            return report
        return {
            "trades": self.weekly_trades,
            "pnl": self.weekly_pnl,
            "win_rate": self.risk_engine.get_win_rate()
        }

    def check_drawdown_limit(self, max_drawdown_percent=15.0):
        if self.risk_engine.initial_balance > 0:
            dd = (self.risk_engine.initial_balance - self.risk_engine.current_balance) / self.risk_engine.initial_balance * 100
            if dd > max_drawdown_percent:
                self.safety_layer.activate_kill_switch(f"Просадка {dd:.1f}%")
                return True
        return False

    def emergency_reduce_lot(self):
        if self.risk_engine.consecutive_losses >= 3:
            return 0.5
        return 1.0

    def get_best_trading_hours(self):
        return self.analytics_engine.get_best_trading_hours()

    def get_worst_trading_hours(self):
        return self.analytics_engine.get_worst_trading_hours()

    def filter_by_day_of_week(self):
        day = datetime.now().strftime("%A")
        day_stats = self.analytics_engine.filter_by_day_of_week(day)
        if day_stats:
            avg_pnl = sum(day_stats) / len(day_stats)
            if avg_pnl < -50:
                return "skip"
            if avg_pnl < 0:
                return "reduce"
        return "normal"

    def adaptive_risk_per_trade(self):
        wr = self.risk_engine.get_win_rate()
        if wr > 0.7:
            return self.risk_engine.max_risk_percent * 1.5
        if wr < 0.4:
            return self.risk_engine.max_risk_percent * 0.5
        return self.risk_engine.max_risk_percent

    def log_signal_quality(self, signal, score):
        self.signal_log.append({
            "time": datetime.now().isoformat(),
            "pattern": signal.pattern,
            "direction": signal.direction.name,
            "score": score,
            "confidence": signal.confidence,
            "r_ratio": signal.r_ratio
        })
        if len(self.signal_log) > 1000:
            self.signal_log = self.signal_log[-500:]

    def replay_closed_trades(self, position, realized_pnl):
        self.closed_trades_log.append({
            "ticket": position.ticket,
            "pattern": position.pattern,
            "direction": position.direction.name,
            "entry": position.entry_price,
            "tp": position.take_profit,
            "sl": 0.0,
            "pnl": realized_pnl,
            "open_time": position.open_time.isoformat(),
            "close_time": datetime.now().isoformat()
        })
        if len(self.closed_trades_log) > 500:
            self.closed_trades_log = self.closed_trades_log[-250:]

    def chat(self, message: str) -> str:
        msg_lower = message.lower().strip()

        if msg_lower.startswith('/mode'):
            parts = msg_lower.split()
            if len(parts) > 1:
                mode_map = {"aurum": StrategyMode.AURUM_V3, "manual": StrategyMode.MANUAL}
                if parts[1] in mode_map:
                    self.mode = mode_map[parts[1]]
                    return f"✅ Режим: **{self.mode.value.upper()}**"
            return "Укажите: /mode aurum, /mode manual"

        weekly = self.weekly_report()
        analytics = self.get_analytics_report()

        context = {
            "status": self.get_status(),
            "positions": [
                {"direction": p.direction.name, "entry": p.entry_price,
                 "sl": 0.0, "tp": p.take_profit, "pnl": 0}
                for p in self.positions
            ],
            "last_signal": (
                {
                    "direction": self.last_signal.direction.name,
                    "pattern": self.last_signal.pattern,
                    "entry": self.last_signal.entry_price,
                    "r_ratio": self.last_signal.r_ratio,
                    "score": self.signal_log[-1]["score"] if self.signal_log else 0
                }
                if self.last_signal else None
            ),
            "session_active": self.aurum_engine.is_active_session(),
            "weekly_report": weekly,
            "analytics": analytics,
            "regime": self.market_intel.get_regime()
        }
        return self.chat_engine.generate_response(message, context)

    def get_status(self) -> Dict:
        return {
            "mode": self.mode.value,
            "session_active": self.aurum_engine.is_active_session(),
            "h4_context": self.aurum_engine.get_h4_context().name if self.h4_candles else "N/A",
            "open_positions": len(self.positions),
            "signals_today": self.signals_today,
            "daily_pnl": round(self.daily_pnl, 2),
            "risk_score": self.risk_engine.compute_portfolio_risk_score(),
            "market_regime": self.market_intel.get_regime()
        }

    def get_analytics_report(self) -> Dict:
        return self.analytics_engine.get_full_report()

    def get_full_institutional_report(self) -> Dict:
        weekly = self.weekly_report()
        return {
            "status": self.get_status(),
            "analytics": self.get_analytics_report(),
            "risk": self.risk_engine.get_full_risk_report(),
            "market": self.market_intel.get_market_summary(),
            "safety": self.safety_layer.get_safety_report(),
            "weekly": weekly,
            "signal_log_size": len(self.signal_log),
            "closed_trades_size": len(self.closed_trades_log)
        }

    def on_autotrade_start(self):
        self.is_running = True
        threading.Thread(target=self._main_loop, daemon=True).start()
        logger.info("Автоторговля запущена")
        return "✅ Автоторговля запущена"

    def on_autotrade_stop(self):
        self.is_running = False
        logger.info("Автоторговля остановлена")
        return "⏹ Автоторговля остановлена"

    def _main_loop(self):
        while self.is_running:
            try:
                self.daily_reset_stats()
                self.check_drawdown_limit()
                self.think_and_decide()
                self.manage_open_positions()
            except Exception as e:
                logger.error(f"Ошибка цикла: {e}")
            time.sleep(60)

    def shutdown(self):
        self.is_running = False
        self.persistence.save_all({
            "analytics": self.analytics_engine,
            "risk": self.risk_engine,
            "signal_log": self.signal_log,
            "closed_trades_log": self.closed_trades_log
        })
        self.mt5.disconnect()
        self.event_bus.stop()
        logger.info("Бот остановлен")

    def manual_kill_switch(self):
        self.safety_layer.activate_kill_switch("manual")
        return "KILL SWITCH активирован"

    def emergency_flatten(self):
        for pos in self.positions[:]:
            self.mt5.close_position(pos.ticket)
        self.positions.clear()
        return "Все позиции закрыты"

# ============================================================
# РЕАЛЬНАЯ ТОРГОВЛЯ
# ============================================================

def main():
    """
    Точка входа для реальной торговли.
    Подключается к MT5, запускает автоторговлю и чат-интерфейс.
    """
    print("=" * 60)
    print("   AURUM V3.0 — XAU/USD — РЕАЛЬНАЯ ТОРГОВЛЯ")
    print(f"   Лот: {FIXED_LOT} | Баланс: ${INITIAL_BALANCE}")
    print(f"   TP: адаптивный (мин ${MIN_PROFIT_DOLLARS}) | SL: ОТКЛЮЧЕН")
    print("=" * 60)

    # Создаём и инициализируем бота
    ai = MasterAI()
    ai.initialize()

    # Запускаем автоторговлю
    print("\n🔁 Запуск автоторговли...")
    ai.on_autotrade_start()

    # Основной цикл — чат с ботом
    print("\n💬 ЧАТ С БОТОМ (введите 'exit' для выхода):")
    print("Доступные команды: /status, /positions, /signal, /mode [aurum|manual], /weekly, /report, /help")
    print("-" * 60)

    try:
        while True:
            user_input = input("👤 Вы: ").strip()
            if not user_input:
                continue
            
            if user_input.lower() == 'exit':
                print("👋 Завершение работы...")
                break
            
            # Обработка команд
            response = ai.chat(user_input)
            print(f"🤖 Бот: {response}")
            print("-" * 60)

    except KeyboardInterrupt:
        print("\n⚠️ Принудительное завершение...")
    finally:
        # Корректное завершение
        ai.on_autotrade_stop()
        ai.shutdown()
        print("✅ Бот остановлен. Все позиции под контролем MT5.")
        print("=" * 60)

if __name__ == "__main__":
    main()
```
